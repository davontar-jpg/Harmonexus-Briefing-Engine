{
  "families": {
    "display": "Cormorant Garamond",
    "interface": "IBM Plex Sans",
    "numeric": "IBM Plex Mono"
  },
  "scale": {
    "xs": 12,
    "sm": 14,
    "md": 16,
    "lg": 20,
    "xl": 28,
    "xxl": 42,
    "display": 64
  },
  "tracking": {
    "displayEm": -0.018,
    "interfaceEm": 0.005,
    "labelEm": 0.075
  },
  "lineHeight": {
    "tight": 1.1,
    "standard": 1.42,
    "reading": 1.62
  },
  "rules": [
    "Numerics use tabular figures.",
    "Risk and state labels remain explicit.",
    "Analytical text prioritizes measure and hierarchy."
  ]
}